<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surfaceContainerLowest"
    tools:context=".presentation.main.screen.collection.CollectionFragment">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/audio_upload_state"
        style="@style/TextAppearance.VisualMusic.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_60dp"
        android:paddingBottom="@dimen/margin_10dp"
        android:text="@string/upload_audio_text"
        android:textAllCaps="true"
        android:textColor="@color/md_theme_onSurface"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <app.visualmusic.common.view.AudioFileInfoView
        android:id="@+id/audio_file_info"
        android:layout_width="@dimen/width_360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:visibility="gone"
        app:audioDurationTextAppearance="@style/TextAppearance.VisualMusic.BodyMedium"
        app:audioNameTextAppearance="@style/TextAppearance.VisualMusic.TitleMedium"
        app:audioSizeTextAppearance="@style/TextAppearance.VisualMusic.BodyMedium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/audio_upload_state" />

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.VisualMusic.Button.Elevated"
        android:layout_width="@dimen/width_200dp"
        android:layout_height="@dimen/height_60dp"
        android:layout_marginTop="@dimen/margin_30dp"
        android:text="@string/select_audio_btn"
        app:icon="@drawable/ic_file_plus"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/audio_file_info" />

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.VisualMusic.Button"
        android:layout_width="@dimen/width_300dp"
        android:layout_height="@dimen/height_60dp"
        android:layout_marginBottom="@dimen/margin_25dp"
        android:enabled="false"
        android:text="@string/generate_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>