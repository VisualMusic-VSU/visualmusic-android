<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surfaceContainerLowest">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:collapsedTitleTextAppearance="@style/TextAppearance.VisualMusic.TitleLarge"
            app:contentScrim="@color/md_theme_surfaceContainerLowest"
            app:expandedTitleTextColor="@color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:title="@string/mock_cover_name">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_45dp"
                app:layout_collapseMode="parallax">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/cover_slider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cover_activity_image_size"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/cover_name"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:text="@string/mock_cover_name"
                    android:textColor="@color/md_theme_onSurface"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cover_slider" />

                <LinearLayout
                    android:id="@+id/cover_info_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"

                    app:layout_constraintTop_toBottomOf="@id/cover_name">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/additional_info_text"
                        style="@style/TextAppearance.Material3.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mock_additional_info"
                        android:textColor="@color/md_theme_onSurfaceVariant" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.Material3.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cover_info_text_separator"
                        android:textColor="@color/md_theme_onSurfaceVariant" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/created_date_text"
                        style="@style/TextAppearance.Material3.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mock_created_date"
                        android:textColor="@color/md_theme_onSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:paddingBottom="@dimen/margin_10dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cover_info_layout">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/change_privacy_btn"
                        style="@style/Widget.VisualMusic.IconButton"
                        android:layout_width="@dimen/width_65dp"
                        android:layout_height="@dimen/height_65dp"
                        app:icon="@drawable/ic_lock" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/delete_btn"
                        style="@style/Widget.VisualMusic.IconButton"
                        android:layout_width="@dimen/width_65dp"
                        android:layout_height="@dimen/height_65dp"
                        android:layout_marginStart="@dimen/margin_10dp"
                        app:icon="@drawable/ic_trash_thin" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/gen_again_btn"
                        style="@style/Widget.VisualMusic.IconButton"
                        android:layout_width="@dimen/width_65dp"
                        android:layout_height="@dimen/height_65dp"
                        android:layout_marginStart="@dimen/margin_10dp"
                        app:icon="@drawable/ic_refresh_thin" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_to_saved_btn"
                        style="@style/Widget.VisualMusic.IconButton"
                        android:layout_width="@dimen/width_65dp"
                        android:layout_height="@dimen/height_65dp"
                        android:layout_marginStart="@dimen/margin_10dp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_heart_thin" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/edit_btn"
                        style="@style/Widget.VisualMusic.IconButton"
                        android:layout_width="@dimen/width_65dp"
                        android:layout_height="@dimen/height_65dp"
                        android:layout_marginStart="@dimen/margin_10dp"
                        app:icon="@drawable/ic_pencil_ruler_thin" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/save_to_device_btn"
                        style="@style/Widget.VisualMusic.IconButton"
                        android:layout_width="@dimen/width_65dp"
                        android:layout_height="@dimen/height_65dp"
                        android:layout_marginStart="@dimen/margin_10dp"
                        app:icon="@drawable/ic_download_thin" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/offset_view_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.appbar.MaterialToolbar
                style="@style/Widget.VisualMusic.TopAppBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_45dp"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_left" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/cover_settings_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/offset_view_drag_handle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.VisualMusic.CardView.CoverActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="6dp"
                        android:src="@drawable/ic_drag_handle" />

                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/md_theme_surfaceContainerLowest"
                android:paddingHorizontal="@dimen/padding_10dp">

                <app.visualmusic.common.view.GenerationParameterView
                    android:id="@+id/genres_parameter_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:parameterName="@string/genres_setting_name">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/genres_parameters_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.VisualMusic.Chip.GenParameter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_genre_parameter" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.VisualMusic.Chip.GenParameter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_genre_parameter" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.VisualMusic.Chip.GenParameter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_genre_parameter" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.VisualMusic.Chip.GenParameter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_genre_parameter" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.VisualMusic.Chip.GenParameter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_genre_parameter" />

                        <!-- Add more genre chips here -->
                    </com.google.android.material.chip.ChipGroup>

                </app.visualmusic.common.view.GenerationParameterView>

                <app.visualmusic.common.view.GenerationParameterView
                    android:id="@+id/mood_parameter_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_5dp"
                    app:layout_constraintTop_toBottomOf="@id/genres_parameter_view"
                    app:parameterName="@string/mood_setting_name">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/mood_parameter"
                        style="@style/Widget.VisualMusic.Chip.GenParameter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mock_mood_parameter" />

                </app.visualmusic.common.view.GenerationParameterView>

                <app.visualmusic.common.view.GenerationParameterView
                    android:id="@+id/style_parameter_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_5dp"
                    app:layout_constraintTop_toBottomOf="@id/mood_parameter_view"
                    app:parameterName="@string/style_setting_name">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/style_parameter"
                        style="@style/Widget.VisualMusic.Chip.GenParameter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mock_style_parameter" />

                </app.visualmusic.common.view.GenerationParameterView>

                <app.visualmusic.common.view.GenerationParameterView
                    android:id="@+id/text_parameter_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_5dp"
                    app:layout_constraintTop_toBottomOf="@id/style_parameter_view"
                    app:parameterName="@string/text_setting_name">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.VisualMusic.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/text_parameter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:gravity="top|start"
                            android:hint="@string/input_prompt_text_field_hint"
                            android:inputType="textMultiLine"
                            android:paddingVertical="@dimen/padding_0dp"
                            android:paddingStart="@dimen/padding_2dp"
                            android:paddingEnd="@dimen/padding_5dp"
                            android:text="@string/mock_text_parameter"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/md_theme_onSurfaceVariant" />

                    </com.google.android.material.textfield.TextInputLayout>

                </app.visualmusic.common.view.GenerationParameterView>

                <app.visualmusic.common.view.GenerationParameterView
                    android:id="@+id/prompt_parameter_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:parameterName="@string/prompt_parameter_name">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.VisualMusic.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="none"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/prompt_parameter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:gravity="top|start"
                            android:hint="@string/input_prompt_text_field_hint"
                            android:inputType="textMultiLine"
                            android:paddingVertical="@dimen/padding_0dp"
                            android:paddingStart="@dimen/padding_2dp"
                            android:paddingEnd="@dimen/padding_5dp"
                            android:text="@string/mock_prompt_parameter"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/md_theme_onSurfaceVariant" />

                    </com.google.android.material.textfield.TextInputLayout>

                </app.visualmusic.common.view.GenerationParameterView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>