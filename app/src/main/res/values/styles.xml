<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--  Button  -->
    <style name="Widget.VisualMusic.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_15dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.VisualMusic.Button.Elevated" parent="Widget.Material3.Button.ElevatedButton">
        <item name="cornerRadius">@dimen/corner_15dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.VisualMusic.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/corner_15dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.VisualMusic.Button.OutlinedButton.IconOnly" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:gravity">center</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.VisualMusic.Button.OAuth.VK" parent="Widget.VisualMusic.Button">
        <item name="android:textColor">@color/oauth_vk_onPrimary</item>
        <item name="rippleColor">@color/oauth_vk_rippleColor</item>
        <item name="backgroundTint">@color/oauth_vk_primary</item>
        <item name="iconTint">@color/oauth_vk_onPrimary</item>
        <item name="iconSize" />
    </style>

    <!--  Text Field  -->
    <style name="Widget.VisualMusic.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopEnd">@dimen/corner_10dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_10dp</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_10dp</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_10dp</item>
    </style>


    <!--  Main Screen CardView  -->
    <style name="Widget.VisualMusic.CardView.MainScreen" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearanceOverlay">
            @style/ShapeAppearance.VisualMusic.CardView.MainScreen
        </item>
    </style>



    <style name="ShapeAppearance.VisualMusic.CardView.MainScreen" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/corner_40dp</item>
        <item name="cornerSizeTopRight">@dimen/corner_40dp</item>
        <item name="cornerSizeBottomLeft">@dimen/corner_0dp</item>
        <item name="cornerSizeBottomRight">@dimen/corner_0dp</item>
    </style>

    <!--  Top App Bar  -->
    <style name="Widget.VisualMusic.TopAppBar" parent="Widget.Material3.Toolbar">
        <item name="navigationIconTint">@color/md_theme_onSurface</item>
        <item name="android:theme">@style/ThemeOverlay.VisualMusic.TopAppBar.MenuIcons</item>
    </style>

    <style name="ThemeOverlay.VisualMusic.TopAppBar.MenuIcons" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="iconTint">@color/md_theme_onSurface</item>
    </style>

    <!--  Images  -->
    <style name="Widget.VisualMusic.Image.AppLauncher" parent="Widget.MaterialComponents.ShapeableImageView">
        <item name="shapeAppearance">@style/ShapeAppearance.VisualMusic.Image.Corner_40dp</item>
    </style>

    <style name="ShapeAppearance.VisualMusic.Image.Corner_40dp" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSize">@dimen/corner_40dp</item>
    </style>
</resources>